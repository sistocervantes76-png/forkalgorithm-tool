{
  "name": "fork-algorithm-command-center",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "worker:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply fork-command-center --local",
    "db:migrate:remote": "wrangler d1 migrations apply fork-command-center --remote",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "pretest": "wrangler d1 execute fork-command-center --local --command \"DELETE FROM rate_limits\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
